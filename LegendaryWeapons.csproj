<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.0.0</Version>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>Latest</LangVersion>
        <EnableHarmony>true</EnableHarmony>
        <RootNamespace>LegendaryWeapons</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ContentPacks Include="[CP] Legendary Weapons" Version="$(Version)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="SpaceCore" HintPath="$(GamePath)\Mods\SpaceCore\SpaceCore.dll" Private="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="CombatExtended" HintPath="$(GamePath)\Mods\CombatExtended\CombatExtended.dll" Private="false"/>
    </ItemGroup>

</Project>
